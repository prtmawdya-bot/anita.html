<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Terima Kasih, Kak Hafipah</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0a0b;
    --bg-2:#121214;
    --card:#17171a;
    --line:rgba(255,255,255,.08);
    --text:#d9d9dd;
    --muted:#8d8d95;
    --gold:#d4b36a;
    --gold-soft:#e8d3a0;
    --silver:#c9ccd3;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:'Inter',system-ui,sans-serif;
    background:
      radial-gradient(900px 500px at 15% -10%, rgba(212,179,106,.10), transparent 60%),
      radial-gradient(800px 500px at 100% 110%, rgba(201,204,211,.07), transparent 60%),
      var(--bg);
    color:var(--text);
    line-height:1.8;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
    animation:bodyIn 1s ease both;
  }
  @keyframes bodyIn{from{opacity:0}to{opacity:1}}

  /* Fade-in */
  .fade{opacity:0;transform:translateY(22px);animation:fadeUp 1.2s cubic-bezier(.22,.8,.3,1) forwards}
  .d1{animation-delay:.2s}.d2{animation-delay:.5s}.d3{animation-delay:.8s}.d4{animation-delay:1.1s}
  @keyframes fadeUp{to{opacity:1;transform:none}}

  .wrap{max-width:1180px;margin:0 auto;padding:64px 24px 80px}

  /* Header */
  header{text-align:center;margin-bottom:64px}
  .eyebrow{
    font-size:.72rem;letter-spacing:.38em;text-transform:uppercase;color:var(--gold);
    display:inline-flex;align-items:center;gap:14px;
  }
  .eyebrow::before,.eyebrow::after{content:"";width:34px;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}
  .eyebrow::after{transform:scaleX(-1)}
  h1{
    font-family:'Cormorant Garamond',serif;font-weight:600;
    font-size:clamp(2.6rem,7vw,5rem);line-height:1.1;margin:22px 0 14px;
    background:linear-gradient(120deg,#f4e7c3 0%,var(--gold) 45%,var(--silver) 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .subtitle{color:var(--muted);font-weight:300;letter-spacing:.06em;font-size:.98rem}

  /* Kepada / Dari */
  .meta{
    display:inline-flex;gap:0;margin-top:30px;border:1px solid var(--line);border-radius:999px;
    background:rgba(255,255,255,.02);overflow:hidden;
  }
  .meta div{padding:10px 26px;font-size:.85rem;letter-spacing:.04em}
  .meta div + div{border-left:1px solid var(--line)}
  .meta span{display:block;font-size:.62rem;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);line-height:1.4}
  .meta b{font-family:'Cormorant Garamond',serif;font-weight:600;font-size:1.25rem;color:var(--gold-soft)}

  /* Layout */
  .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:start}

  /* Letter */
  .letter{
    background:linear-gradient(160deg,var(--card),var(--bg-2));
    border:1px solid var(--line);border-radius:24px;
    padding:clamp(28px,5vw,56px);
    box-shadow:0 30px 70px -30px rgba(0,0,0,.8), inset 0 1px 0 rgba(255,255,255,.04);
    position:relative;
  }
  .letter::before{
    content:"";position:absolute;top:0;left:50px;right:50px;height:1px;
    background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.7;
  }
  .letter .greet{font-family:'Cormorant Garamond',serif;font-size:1.8rem;color:var(--gold-soft);margin-bottom:20px}
  .letter p{margin-bottom:18px;font-weight:300;font-size:1rem;text-align:justify;hyphens:auto}
  .letter p strong{color:var(--gold-soft);font-weight:500}
  .sign{margin-top:36px;padding-top:26px;border-top:1px solid var(--line)}
  .sign .closing{color:var(--muted);font-size:.9rem;margin-bottom:6px}
  .sign .name{
    font-family:'Cormorant Garamond',serif;font-style:italic;font-size:2.1rem;color:var(--gold);line-height:1.3
  }
  .sign .role{font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-top:4px}

  /* Gallery */
  .gallery{position:sticky;top:32px}
  .gallery-title{
    font-size:.72rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);
    margin-bottom:18px;text-align:center;
  }
  .slider{
    position:relative;border-radius:26px;overflow:hidden;
    border:1px solid var(--line);background:var(--card);
    box-shadow:0 35px 80px -25px rgba(0,0,0,.9), 0 0 0 6px rgba(255,255,255,.015);
    touch-action:pan-y;user-select:none;
  }
  .track{display:flex;transition:transform .8s cubic-bezier(.22,.8,.3,1);will-change:transform}
  .track.dragging{transition:none}
  .slide{min-width:100%;aspect-ratio:4/5;position:relative;background:#101012}
  .slide img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;-webkit-user-drag:none}
  .slide::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(to top,rgba(0,0,0,.45),transparent 35%);pointer-events:none;
  }
  .counter{
    position:absolute;left:18px;bottom:16px;z-index:2;font-size:.8rem;letter-spacing:.2em;color:var(--silver);
  }
  .arrow{
    position:absolute;top:50%;transform:translateY(-50%);z-index:3;
    width:46px;height:46px;border-radius:50%;
    border:1px solid rgba(255,255,255,.18);background:rgba(10,10,11,.55);
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    color:var(--gold-soft);cursor:pointer;display:grid;place-items:center;
    transition:all .35s ease;
  }
  .arrow:hover{background:var(--gold);color:#111;border-color:var(--gold)}
  .arrow svg{width:20px;height:20px}
  .prev{left:14px}.next{right:14px}
  .dots{display:flex;justify-content:center;gap:10px;margin-top:20px}
  .dot{
    width:8px;height:8px;border-radius:99px;border:none;background:rgba(255,255,255,.2);
    cursor:pointer;transition:all .5s ease;
  }
  .dot.active{width:30px;background:linear-gradient(90deg,var(--gold),var(--gold-soft))}

  footer{text-align:center;margin-top:70px;color:var(--muted);font-size:.8rem;letter-spacing:.18em;text-transform:uppercase}
  footer span{color:var(--gold)}

  @media(max-width:900px){
    .grid{grid-template-columns:1fr;gap:44px}
    .gallery{position:static}
    .wrap{padding:44px 18px 60px}
    header{margin-bottom:44px}
    .letter p{text-align:left}
  }
  @media(max-width:480px){
    .arrow{width:40px;height:40px}
    .slider{border-radius:20px}
    .meta div{padding:10px 18px}
  }
  @media(prefers-reduced-motion:reduce){
    *{animation-duration:.01s!important;transition-duration:.01s!important}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="eyebrow fade d1">PPKMB • Ucapan Terima Kasih</div>
    <h1 class="fade d2">Kelompok Vertex</h1>
    <p class="subtitle fade d3">Sebuah surat kecil untuk seseorang yang berarti besar</p>
    <div class="meta fade d4">
      <div><span>Kepada</span><b>Kak Hafipah</b></div>
      <div><span>Dari</span><b>Anita</b></div>
    </div>
  </header>

  <main class="grid">

    <!-- SURAT -->
    <article class="letter fade d3">
      <div class="greet">Kepada Kak Hafipah yang terhormat,</div>

      <p>Melalui surat sederhana ini, izinkan saya, Anita, menyampaikan <strong>terima kasih yang setulus-tulusnya</strong> atas bimbingan Kakak selama rangkaian PPKMB bersama Kelompok Vertex.</p>

      <p>Di hari-hari awal yang penuh rasa canggung dan ragu, Kakak hadir dengan senyum yang menenangkan. Kakak tidak hanya menyampaikan arahan, tetapi juga membuat kami merasa <strong>diterima, didengar, dan tidak sendirian</strong>. Itu adalah hal kecil bagi Kakak, namun sangat berarti bagi kami.</p>

      <p>Saya tahu betul bahwa mengawal sebuah kelompok bukan pekerjaan yang ringan. Ada waktu istirahat yang Kakak korbankan, ada lelah yang Kakak simpan sendiri, dan ada kesabaran yang diuji berkali-kali oleh pertanyaan, keterlambatan, dan kekeliruan kami. Namun Kakak selalu menghadapinya dengan <strong>sabar, hangat, dan penuh perhatian</strong>.</p>

      <p>Dari Kakak, saya belajar bahwa memimpin bukan tentang berdiri paling depan, melainkan tentang berjalan di samping, menuntun tanpa menggurui, dan percaya bahwa setiap orang mampu bertumbuh. Pelajaran itu akan saya bawa jauh melampaui masa PPKMB ini.</p>

      <p>Semoga setiap kebaikan, waktu, dan tenaga yang Kakak berikan kembali berlipat ganda dalam bentuk kebahagiaan, kemudahan, dan keberkahan di setiap langkah Kakak. Kenangan bersama Kelompok Vertex, dan bersama Kakak, akan selalu menjadi awal yang indah dalam perjalanan kami.</p>

      <div class="sign">
        <div class="closing">Dengan hormat dan penuh rasa terima kasih,</div>
        <div class="name">Anita</div>
        <div class="role">Kelompok Vertex • PPKMB</div>
      </div>
    </article>

    <!-- GALERI -->
    <section class="gallery fade d4" aria-label="Galeri foto">
      <div class="gallery-title">Momen Kebersamaan</div>

      <div class="slider" id="slider">
        <div class="track" id="track">
          <div class="slide"><img src="https://i.ibb.co.com/V0TJd4hr/IMG-20261024-WA0018.jpg" alt="Foto kebersamaan 1" loading="eager"></div>
          <div class="slide"><img src="https://i.ibb.co.com/d0cZ5pN6/IMG-20261024-WA0019.jpg" alt="Foto kebersamaan 2" loading="lazy"></div>
          <div class="slide"><img src="https://i.ibb.co.com/prbY1Nfh/IMG-20261024-WA0020.jpg" alt="Foto kebersamaan 3" loading="lazy"></div>
          <div class="slide"><img src="https://i.ibb.co.com/mC2V4nHm/IMG-20261024-WA0021.jpg" alt="Foto kebersamaan 4" loading="lazy"></div>
          <div class="slide"><img src="https://i.ibb.co.com/3yJhR32c/IMG-20261024-WA0022.jpg" alt="Foto kebersamaan 5" loading="lazy"></div>
        </div>

        <button class="arrow prev" id="prev" aria-label="Foto sebelumnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="arrow next" id="next" aria-label="Foto berikutnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="counter" id="counter">01 / 05</div>
      </div>

      <div class="dots" id="dots"></div>
    </section>

  </main>

  <footer>Dengan <span>♥</span> dari Anita untuk Kak Hafipah indah farawansyah</footer>
</div>

<script>
(function(){
  const slider = document.getElementById('slider');
  const track  = document.getElementById('track');
  const total  = track.children.length;
  const dotsEl = document.getElementById('dots');
  const counter= document.getElementById('counter');
  let index = 0, startX = 0, dx = 0, dragging = false, timer;

  for(let i=0;i<total;i++){
    const b = document.createElement('button');
    b.className='dot'; b.setAttribute('aria-label','Ke foto '+(i+1));
    b.addEventListener('click',()=>{go(i);restart();});
    dotsEl.appendChild(b);
  }
  const dots = dotsEl.children;

  const pad = n => String(n).padStart(2,'0');
  function update(){
    track.style.transform = `translateX(${-index*100}%)`;
    [...dots].forEach((d,i)=>d.classList.toggle('active',i===index));
    counter.textContent = `${pad(index+1)} / ${pad(total)}`;
  }
  function go(i){ index = (i+total)%total; update(); }

  document.getElementById('prev').addEventListener('click',()=>{go(index-1);restart();});
  document.getElementById('next').addEventListener('click',()=>{go(index+1);restart();});

  // swipe / drag
  slider.addEventListener('pointerdown',e=>{
    if(e.target.closest('.arrow')) return;
    dragging = true; startX = e.clientX; dx = 0;
    track.classList.add('dragging');
    slider.setPointerCapture(e.pointerId);
    clearInterval(timer);
  });
  slider.addEventListener('pointermove',e=>{
    if(!dragging) return;
    dx = e.clientX - startX;
    const pct = (dx / slider.clientWidth) * 100;
    track.style.transform = `translateX(${-index*100 + pct}%)`;
  });
  function endDrag(){
    if(!dragging) return;
    dragging = false;
    track.classList.remove('dragging');
    const threshold = slider.clientWidth * 0.18;
    if(dx < -threshold) go(index+1);
    else if(dx > threshold) go(index-1);
    else update();
    restart();
  }
  slider.addEventListener('pointerup',endDrag);
  slider.addEventListener('pointercancel',endDrag);

  // keyboard
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowLeft'){go(index-1);restart();}
    if(e.key==='ArrowRight'){go(index+1);restart();}
  });

  // autoplay
  function restart(){ clearInterval(timer); timer=setInterval(()=>go(index+1),5500); }
  slider.addEventListener('mouseenter',()=>clearInterval(timer));
  slider.addEventListener('mouseleave',restart);

  // fallback bila gambar gagal dimuat
  slider.querySelectorAll('img').forEach(img=>{
    img.addEventListener('error',()=>{
      img.style.display='none';
      img.parentElement.style.background='linear-gradient(135deg,#1a1a1e,#0e0e10)';
    });
  });

  update(); restart();
})();
</script>
</body>
  </html>
